### HTTPS only
@Api = https://localhost:7247/api/v1


### POST "/user" - TEST "no payload" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

### POST "/user" - TEST "all empty fields invalid" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

{
  "email":"",
  "password":"",
  "name":""
}

### POST "/user" - TEST "invalid field:email too short & other fields invalid" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

{
  "email":"12345",
  "password":"",
  "name":""
}

### POST "/user" - TEST "invalid field:email pattern & other fields invalid" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

{
  "email":"mysite..1234@yopmail.com",
  "password":"",
  "name":""
}

### POST "/user" - TEST "field:email OK & invalid field:password required & invalid field:name too short" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

{
  "email":"Kalush@yopmail.com",
  "password":"",
  "name":""
}

### POST "/user" - TEST "invalid field:password too short & other fields OK" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

{
  "email":"Kalush@yopmail.com",
  "password":"",
  "name":"C"
}

### POST "/user" - TEST "invalid field:password too short & field:password required OK" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

{
  "email":"Kalush@yopmail.com",
  "password":"1234567",
  "name":"C"
}

### POST "/user" - TEST "invalid field:password pattern & other fields OK" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

{
  "email":"Kalush@yopmail.com",
  "password":"12345678",
  "name":"C"
}

### POST "/user" - TEST creation attempt (no 'name') -> 201 Created
POST {{Api}}/user
Content-Type: application/json

{
  "email":"Kalush@yopmail.com",
  "password":"Aa@12345"
}

### POST "/user" - TEST creation repeats (all fields) -> 409 Conflict
POST {{Api}}/user
Content-Type: application/json

{
  "email":"Isk@yopmail.com",
  "password":"Ii@12345",
  "name":"Isk"
}



### GET "/user" - TEST list of users TODO: AUTH + API filters DTO by Token claim "role" (no payload, no query param)
GET {{Api}}/user
Content-Type: application/json


@Id = 01a14087-f10f-779a-93e5-b47dbc3966f4

### get ID value from first cal to POST "/user"
### GET "/user/:id" - TEST user profile TODO: AUTH + API filters DTO by Token claim "role" (no payload, no query param)
GET {{Api}}/user/{{Id}}
Content-Type: application/json
