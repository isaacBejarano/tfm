### <- HTTPS only
@Api = https://localhost:7247/api/v1



### POST "/users"
#################



### POST "/users" - Signup "no payload" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

### POST "/users" - Signup "all empty fields invalid" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"",
  "password":"",
  "name":""
}

### POST "/users" - Signup "invalid field:email too short & other fields invalid" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"12345",
  "password":"",
  "name":""
}

### POST "/users" - Signup "invalid field:email pattern & other fields invalid" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"mysite..1234@yopmail.com",
  "password":"",
  "name":""
}

### POST "/users" - Signup "field:email OK & invalid field:password required & invalid field:name too short" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"",
  "name":""
}

### POST "/users" - Signup "invalid field:password too short & other fields OK" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"",
  "name":"C"
}

### POST "/users" - Signup "invalid field:password too short & field:password required OK" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"1234567",
  "name":"C"
}

### POST "/users" - Signup "invalid field:password pattern & other fields OK" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"12345678",
  "name":"C"
}

### POST "/users" - Signup (no 'name') -> 201 Created
POST {{Api}}/users
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"Ff@12345"
}

### POST "/users" - Signup creation repeats (all fields) -> 409 Conflict
POST {{Api}}/users
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"Ff@12345",
  "name":"Kazka"
}



### GET "/users"
################



### GET "/users" - User List (no Access Token) -> 401 Unauthorized
GET {{Api}}/users
Content-Type: application/json

### GET "/users" - User List (no Access Token) -> 401 Unauthorized
GET {{Api}}/users
Content-Type: application/json
Authorization: ""

### GET "/users" - User List (no Access Token) -> 401 Unauthorized
GET {{Api}}/users
Content-Type: application/json
Authorization: "Bearer"

### GET "/users" - User List (Access Token expired) -> 401 Unauthorized
GET {{Api}}/users
Content-Type: application/json
Authorization: "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Tglgg4lsn-rfbelfUAYG8pQy4pQMWTvkvGvYxsA69dc

### <- get ACCESS TOKEN from Login (POST "/auth") as SEED USER 2 (e.g. Kalush@yopmail.com)
@TokenAccessOfSeedUser1 = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..4_oOtIUEUX8K3pDwua0PuajNN96XYLnP_FYRaWc-T-Q

### GET "/users" - User List (Access Token but NO Roles 'Admin, Super') -> 403 Forbidden
GET {{Api}}/users
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser1}}

### <- get ACCESS TOKEN from Login (POST "/auth") as SEED ADMIN 1 (e.g. Tribunal@yopmail.com)
@TokenAccessOfSeedAdmin1A = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..-puLQpz6oM3NTsgSfr_JJlb7uzVvR_nPUfo6Biph4nc

### GET "/users" - User List (Access Token & right Role 'Admin') -> 200 OK
GET {{Api}}/users
Content-Type: application/json
Authorization: {{TokenAccessOfSeedAdmin1A}}

### <- get ACCESS TOKEN from Login (POST "/auth") as SEED SUPER (e.g. Super@yopmail.com)
@TokenAccessOfSeedSuperA = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..xPHX8D1PQlPhLzl-u9fZt_q4yTJ3SRpSowTeIA1Jz8k

### GET "/users" - User List (Access Token & right Role 'Admin') -> 200 OK
GET {{Api}}/users
Content-Type: application/json
Authorization: {{TokenAccessOfSeedSuperA}}



### GET "/users/:id"
####################



### ID of SEED USER 1 (Kalush@yopmail.com)
@IdOfSeedUser1 = 019532a1-8000-7a1b-8000-000000000001

### ID of SEED USER 2 (Dorofeeva@yopmail.com)
@IdOfSeedUser2 = 019532a1-8001-7a1b-8000-000000000002

### ID of SEED ADMIN 1 (Tribunal@yopmail.com)
@IdOfSeedAdmin1 = 019532a1-8006-7a1b-8000-000000000007

### ID of SEED ADMIN 2 (Admin@yopmail.com)
@IdOfSeedAdmin2 = 019532a1-8007-7a1b-8000-000000000008

### ID of SEED SUPER (Super@yopmail.com)
@IdOfSeedSuper = 019532a1-8008-7a1b-8000-000000000009

### <- get ACCESS TOKEN from Login (POST "/auth") as SEED USER 2 (Dorofeeva@yopmail.com)
@TokenAccessOfSeedUser2 = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..621hr_hIUIheQE8LC-xHc2EvFNACU4YqqQzUobXxa5M

### GET "/users/:id" - Authenticated role 'User' can only READ itself -> 200 OK
GET {{Api}}/users/{{IdOfSeedUser2}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser2}}

### GET "/users/:id" - Authenticated role 'User' can NOT READ ohter 'User' -> 403 Forbidden
GET {{Api}}/users/{{IdOfSeedUser1}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser2}}

### GET "/users/:id" - Authenticated role 'User' can NOT READ role 'Admin' -> 403 Forbidden
GET {{Api}}/users/{{IdOfSeedAdmin1}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser2}}

### GET "/users/:id" - Authenticated role 'User' can NOT READ role 'Super' -> 403 Forbidden
GET {{Api}}/users/{{IdOfSeedSuper}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser2}}

### <- get ACCESS TOKEN from Login (POST "/auth") as SEED ADMIN 1 (Tribunal@yopmail.com)
@TokenAccessOfSeedAdmin1B = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..1JdhDnofX5PsLWKqmGCAJ6v-1jAOv13y2quQ4XOfJp0

### GET "/users/:id" - Authenticated role 'Admin' can READ itself -> 200 OK
GET {{Api}}/users/{{IdOfSeedAdmin1}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedAdmin1B}}

### GET "/users/:id" - Authenticated role 'Admin' can READ role 'User' -> 200 OK
GET {{Api}}/users/{{IdOfSeedUser1}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedAdmin1B}}

### GET "/users/:id" - Authenticated role 'Admin' can NOT READ ohter 'Admin' -> 403 Forbidden
GET {{Api}}/users/{{IdOfSeedAdmin2}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedAdmin1B}}

### GET "/users/:id" - Authenticated role 'Admin' can NOT READ role 'Super' -> 403 Forbidden
GET {{Api}}/users/{{IdOfSeedSuper}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedAdmin1B}}

### <- get ACCESS TOKEN from Login (POST "/auth") as SEED SUPER (Super@yopmail.com)
@TokenAccessOfSeedSuperB = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..qe9tdBuG2o5sPUeAMqhPa2_B_0sXIVQdOz4An7w_P4c

### GET "/users/:id" - Authenticated role 'Super' can READ itself -> 200 OK
GET {{Api}}/users/{{IdOfSeedSuper}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedSuperB}}

### GET "/users/:id" - Authenticated role 'Super' can READ role 'User' -> 200 OK
GET {{Api}}/users/{{IdOfSeedUser1}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedSuperB}}

### GET "/users/:id" - Authenticated role 'Super' can READ role 'Admin' -> 200 OK
GET {{Api}}/users/{{IdOfSeedAdmin1}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedSuperB}}

### There is only 1 'Super'



### PATCH "/users/:id"
####################



# FIXME:

### <- get ID from Login (POST "/auth") as NEW USER -NOT SEED- (Kazka@yopmail.com)
@IdOfNewUser = 01a18443-5498-7f9d-b96b-41d98bbc8544

### <- get ACCESS TOKEN from Login (POST "/auth") as NEW USER 10 (Kazka@yopmail.com)
@TokenAccessOfSeedUser10 = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..37YtLJWAKKij48RryG1f4EREOhgm9ziljeefCguPf2Q

### PATCH "/users/:id" - Edit user profile with role 'User' - change Name
PATCH {{Api}}/users/{{IdOfNewUser}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser10}}

{
  "password":null,
  "name":"казка"
}

### PATCH "/users/:id" - Edit user profile with role 'User' - change Password
PATCH {{Api}}/users/{{IdOfNewUser}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser10}}

{
  "password":"Gg@12345",
  "name":null
}

### PATCH "/users/:id" - Edit user profile with role 'User' - no changes
PATCH {{Api}}/users/{{IdOfNewUser}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser10}}

{
  "password":null,
  "name":null
}
