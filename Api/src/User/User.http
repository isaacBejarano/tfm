### <- HTTPS only
@Api = https://localhost:7247/api/v1


### POST "/users" - Signup "no payload" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

### POST "/users" - Signup "all empty fields invalid" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"",
  "password":"",
  "name":""
}

### POST "/users" - Signup "invalid field:email too short & other fields invalid" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"12345",
  "password":"",
  "name":""
}

### POST "/users" - Signup "invalid field:email pattern & other fields invalid" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"mysite..1234@yopmail.com",
  "password":"",
  "name":""
}

### POST "/users" - Signup "field:email OK & invalid field:password required & invalid field:name too short" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"",
  "name":""
}

### POST "/users" - Signup "invalid field:password too short & other fields OK" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"",
  "name":"C"
}

### POST "/users" - Signup "invalid field:password too short & field:password required OK" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"1234567",
  "name":"C"
}

### POST "/users" - Signup "invalid field:password pattern & other fields OK" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"12345678",
  "name":"C"
}

### POST "/users" - Signup (no 'name') -> 201 Created
POST {{Api}}/users
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"Ff@12345"
}

### POST "/users" - Signup creation repeats (all fields) -> 409 Conflict
POST {{Api}}/users
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"Ff@12345",
  "name":"Kazka"
}

### <- get ACCESS TOKEN from call to POST "/auth" as SEED USER (e.g. Dorofeeva@yopmail.com)
@TokenAccessRoleUser = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..-DC82KyHYTSyv7eeNvXJSPhi43LyUmsq1Z2aVRqbWVo

### GET "/users" - User List (no Access Token) -> 401 Unauthorized
GET {{Api}}/users
Content-Type: application/json

### GET "/users" - User List (no Access Token) -> 401 Unauthorized
GET {{Api}}/users
Content-Type: application/json
Authorization: ""

### GET "/users" - User List (no Access Token) -> 401 Unauthorized
GET {{Api}}/users
Content-Type: application/json
Authorization: "Bearer"

### GET "/users" - User List (Access Token expired) -> 401 Unauthorized
GET {{Api}}/users
Content-Type: application/json
Authorization: "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Tglgg4lsn-rfbelfUAYG8pQy4pQMWTvkvGvYxsA69dc

### GET "/users" - User List (Access Token but NO Roles 'Admin, Super') -> 403 Forbidden
GET {{Api}}/users
Content-Type: application/json
Authorization: {{TokenAccessRoleUser}}


### <- get ACCESS TOKEN from call to POST "/auth" as SEED ADMIN (e.g. Tribunal@yopmail.com)
@TokenAccessRoleAdmin = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..nM1aKQe5Jpz-VkUauwWv3vQYCGR58-llvyiUI1BouXI

### GET "/users" - User List (Access Token & right Role 'Admin') -> 200 OK
GET {{Api}}/users
Content-Type: application/json
Authorization: {{TokenAccessRoleAdmin}}

# FIXME: 'Admin' cannot list 'Super'


### <- get ACCESS TOKEN from call to POST "/auth" as SEED SUPERADMIN (e.g. Super@yopmail.com)
@TokenAccessRoleSuper = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..PnX48yVsfwy-N83vtySsKZtdu8av1h5_Y7s_LOnNWrM

### GET "/users" - User List (Access Token & right Role 'Super') -> 200 OK
GET {{Api}}/users
Content-Type: application/json
Authorization: {{TokenAccessRoleSuper}}


# TODO: rest of endpoints

### z- get ID value from first call to POST "/users" (or from a SEED record)
@Id = 0195e280-1005-7100-8000-000000000006

### GET "/users/:id" - user profile - FIXME: AUTH + API filters DTO by Token claim "role" (no payload, no query param)
GET {{Api}}/users/{{Id}}
Content-Type: application/json
Authorization: {{TokenAccessRoleUser}}

# FIXME: refactor src naming in plural? ([Route("api/users")]) for REST?
