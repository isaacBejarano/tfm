### <- get ACCESS TOKEN from Login (POST "/auth") as SEED USER 2 (USER_2_EMAIL)
@TokenAccessOfSeedUser2 =

### GET "/users/:id" - Authenticated role 'User' can only READ itself -> 200 OK
GET {{Api}}/users/{{IdOfSeedUser2}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser2}}

### GET "/users/:id" - Authenticated role 'User' can NOT READ ohter 'User' -> 403 Forbidden
GET {{Api}}/users/{{IdOfSeedUser1}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser2}}

### GET "/users/:id" - Authenticated role 'User' can NOT READ role 'Admin' -> 403 Forbidden
GET {{Api}}/users/{{IdOfSeedAdmin1}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser2}}

### GET "/users/:id" - Authenticated role 'User' can NOT READ role 'Super' -> 403 Forbidden
GET {{Api}}/users/{{IdOfSeedSuper}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser2}}


### <- get ACCESS TOKEN from Login (POST "/auth") as SEED ADMIN 11 (USER_11_EMAIL)
@TokenAccessOfSeedAdmin1B =

### GET "/users/:id" - Authenticated role 'Admin' can READ itself -> 200 OK
GET {{Api}}/users/{{IdOfSeedAdmin1}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedAdmin1B}}

### GET "/users/:id" - Authenticated role 'Admin' can READ role 'User' -> 200 OK
GET {{Api}}/users/{{IdOfSeedUser1}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedAdmin1B}}

### GET "/users/:id" - Authenticated role 'Admin' can NOT READ ohter 'Admin' -> 403 Forbidden
GET {{Api}}/users/{{IdOfSeedAdmin2}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedAdmin1B}}

### GET "/users/:id" - Authenticated role 'Admin' can NOT READ role 'Super' -> 403 Forbidden
GET {{Api}}/users/{{IdOfSeedSuper}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedAdmin1B}}


### <- get ACCESS TOKEN from Login (POST "/auth") as SEED SUPER (USER_13_EMAIL)
@TokenAccessOfSeedSuperB =

### GET "/users/:id" - Authenticated role 'Super' can READ itself -> 200 OK
GET {{Api}}/users/{{IdOfSeedSuper}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedSuperB}}

### GET "/users/:id" - Authenticated role 'Super' can READ role 'User' -> 200 OK
GET {{Api}}/users/{{IdOfSeedUser1}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedSuperB}}

### GET "/users/:id" - Authenticated role 'Super' can READ role 'Admin' -> 200 OK
GET {{Api}}/users/{{IdOfSeedAdmin1}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedSuperB}}

### There is only 1 'Super'



### PATCH "/users/:id"
######################



