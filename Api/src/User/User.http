### <- HTTPS only
@Api = https://localhost:7247/api/v1



### POST "/users"
#################



### POST "/users" - Signup "no payload" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

### POST "/users" - Signup "all empty fields invalid" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"",
  "password":"",
  "name":""
}

### POST "/users" - Signup "invalid field:email too short & other fields invalid" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"12345",
  "password":"",
  "name":""
}

### POST "/users" - Signup "invalid field:email pattern & other fields invalid" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"mysite..1234@yopmail.com",
  "password":"",
  "name":""
}

### POST "/users" - Signup "field:email OK & invalid field:password required & invalid field:name too short" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"{{$dotenv USER_14_EMAIL}}",
  "password":"",
  "name":""
}

### POST "/users" - Signup "invalid field:password too short & other fields OK" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"{{$dotenv USER_14_EMAIL}}",
  "password":"",
  "name":"C"
}

### POST "/users" - Signup "invalid field:password too short & field:password required OK" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"{{$dotenv USER_14_EMAIL}}",
  "password":"1234567",
  "name":"C"
}

### POST "/users" - Signup "invalid field:password pattern & other fields OK" --> 400 Bad Request
POST {{Api}}/users
Content-Type: application/json

{
  "email":"{{$dotenv USER_14_EMAIL}}",
  "password":"12345678",
  "name":"C"
}

### POST "/users" - Signup (no 'name') -> 201 Created
POST {{Api}}/users
Content-Type: application/json

{
  "email":"{{$dotenv USER_14_EMAIL}}",
  "password":"{{$dotenv USER_14_PASS}}"
}

### POST "/users" - Signup creation repeats (all fields) -> 409 Conflict
POST {{Api}}/users
Content-Type: application/json

{
  "email":"{{$dotenv USER_14_EMAIL}}",
  "password":"{{$dotenv USER_14_PASS}}",
  "name":"Kazka"
}

### POST "/users" - Ad hoc NEW USER 15 -> 201 Created
POST {{Api}}/users
Content-Type: application/json

{
  "email":"{{$dotenv USER_15_EMAIL}}",
  "password":"{{$dotenv USER_15_PASS}}",
  "name":"Adhoc User 2"
}

### POST "/users" - Ad hoc NEW USER 16 -> 201 Created
POST {{Api}}/users
Content-Type: application/json

{
  "email":"{{$dotenv USER_16_EMAIL}}",
  "password":"{{$dotenv USER_16_PASS}}",
  "name":"Adhoc User 3"
}

### POST "/users" - Ad hoc NEW USER 17 -> 201 Created
POST {{Api}}/users
Content-Type: application/json

{
  "email":"{{$dotenv USER_17_EMAIL}}",
  "password":"{{$dotenv USER_17_PASS}}",
  "name":"Adhoc User 4"
}



### GET "/users"
################



### GET "/users" - User List (no Access Token) -> 401 Unauthorized
GET {{Api}}/users
Content-Type: application/json

### GET "/users" - User List (no Access Token) -> 401 Unauthorized
GET {{Api}}/users
Content-Type: application/json
Authorization: ""

### GET "/users" - User List (no Access Token) -> 401 Unauthorized
GET {{Api}}/users
Content-Type: application/json
Authorization: Bearer

### GET "/users" - User List (Access Token expired) -> 401 Unauthorized
GET {{Api}}/users
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..tri-WTvt8YSm9xmXiWUP__-IN_5OCXpiYnmJvAEvuRo


### <- get ACCESS TOKEN from Login (POST "/auth") as SEED USER 1 (e.g. USER_1_EMAIL)
@TokenAccessOfSeedUser1 =

### GET "/users" - User List (Access Token but NO Roles 'Admin, Super') -> 403 Forbidden
GET {{Api}}/users
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser1}}


### <- get ACCESS TOKEN from Login (POST "/auth") as SEED ADMIN 1 (e.g. USER_11_EMAIL)
@TokenAccessOfSeedAdmin1A =

### GET "/users" - User List (Access Token & right Role 'Admin') -> 200 OK
GET {{Api}}/users
Content-Type: application/json
Authorization: {{TokenAccessOfSeedAdmin1A}}


### <- get ACCESS TOKEN from Login (POST "/auth") as SEED SUPER (USER_13_EMAIL)
@TokenAccessOfSeedSuperA =

### GET "/users" - User List (Access Token & right Role 'Super') -> 200 OK
GET {{Api}}/users
Content-Type: application/json
Authorization: {{TokenAccessOfSeedSuperA}}



### GET "/users/:id"
####################



