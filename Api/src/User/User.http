### <- HTTPS only
@Api = https://localhost:7247/api/v1


### POST "/user" - TEST "no payload" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

### POST "/user" - TEST "all empty fields invalid" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

{
  "email":"",
  "password":"",
  "name":""
}

### POST "/user" - TEST "invalid field:email too short & other fields invalid" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

{
  "email":"12345",
  "password":"",
  "name":""
}

### POST "/user" - TEST "invalid field:email pattern & other fields invalid" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

{
  "email":"mysite..1234@yopmail.com",
  "password":"",
  "name":""
}

### POST "/user" - TEST "field:email OK & invalid field:password required & invalid field:name too short" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"",
  "name":""
}

### POST "/user" - TEST "invalid field:password too short & other fields OK" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"",
  "name":"C"
}

### POST "/user" - TEST "invalid field:password too short & field:password required OK" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"1234567",
  "name":"C"
}

### POST "/user" - TEST "invalid field:password pattern & other fields OK" --> 400 Bad Request
POST {{Api}}/user
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"12345678",
  "name":"C"
}

### POST "/user" - TEST creation attempt (no 'name') -> 201 Created
POST {{Api}}/user
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"Ff@12345"
}

### POST "/user" - TEST creation repeats (all fields) -> 409 Conflict
POST {{Api}}/user
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"Ff@12345",
  "name":"Kazka"
}

### z- get ACCESS TOKEN from call to POST "/auth" as SEED USER (e.g. Dorofeeva@yopmail.com)
@TokenAccessRoleUser = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..kZXcQ4U-gAm9LI2296v5z5-Rfjc6ZxiSLlduXZjKXjk

### GET "/user" - TEST (no Access Token) -> 401 Unauthorized
GET {{Api}}/user
Content-Type: application/json

### GET "/user" - TEST (no Access Token) -> 401 Unauthorized
GET {{Api}}/user
Content-Type: application/json
Authorization: ""

### GET "/user" - TEST (no Access Token) -> 401 Unauthorized
GET {{Api}}/user
Content-Type: application/json
Authorization: "Bearer"

### GET "/user" - TEST (Access Token expired) -> 401 Unauthorized
GET {{Api}}/user
Content-Type: application/json
Authorization: "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..RucrZA-5jtGlM9eqSHebJwS3dlaXzVPOTWN3cGI_Chc"

### GET "/user" - TEST (Access Token but NO Roles 'Admin, Super') -> 403 Forbidden
GET {{Api}}/user
Content-Type: application/json
Authorization: {{TokenAccessRoleUser}}


### <- get ACCESS TOKEN from call to POST "/auth" as SEED ADMIN (e.g. Tribunal@yopmail.com)
@TokenAccessRoleAdmin = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..j3OUi3eTIkuOCiuRSDaKNJuZKAJME1t2OwQpqVM5U58

### GET "/user" - TEST (Access Token & right Role 'Admin') -> 200 OK
GET {{Api}}/user
Content-Type: application/json
Authorization: {{TokenAccessRoleAdmin}}


### <- get ACCESS TOKEN from call to POST "/auth" as SEED ADMIN (e.g. Super@yopmail.com)
@TokenAccessRoleSuper = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..hao1RgibdfXeo8TvRigq4N4bYpg3hMhOazL0FWL7noo

### GET "/user" - TEST (Access Token & right Role 'Super') -> 200 OK
GET {{Api}}/user
Content-Type: application/json
Authorization: {{TokenAccessRoleSuper}}


# TODO: rest of endpoints

### z- get ID value from first call to POST "/user" (or from a SEED record)
@Id = 0195e280-1005-7100-8000-000000000006

### GET "/user/:id" - TEST user profile - FIXME: AUTH + API filters DTO by Token claim "role" (no payload, no query param)
GET {{Api}}/user/{{Id}}
Content-Type: application/json
Authorization: {{TokenAccessRoleUser}}

