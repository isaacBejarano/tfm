### PATCH "/users/:id" - (no payload) -> 400 Bad Request
PATCH {{Api}}/users/{{IdOfNewUser14}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser14}}

### PATCH "/users/:id" - (null patches) -> 422 Unprocessable Entity
PATCH {{Api}}/users/{{IdOfNewUser14}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser14}}

{
  "name":null,
  "password":null
}

### PATCH "/users/:id" - (null patches) -> 400 Bad Request
PATCH {{Api}}/users/{{IdOfNewUser14}}
Content-Type: application/json
Authorization: {{TokenAccessOfSeedUser14}}

{
  "name":"",
  "password":""
}

### PATCH "/users/:id" - (change Name) -> 200 OK
