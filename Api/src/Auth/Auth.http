### <- HTTPS only
@Api = https://localhost:7247/api/v1


### POST "/auth" - Login "no payload" --> 400 Bad Request
POST {{Api}}/auth
Content-Type: application/json

### POST "/auth" - Login "all empty fields invalid" --> 400 Bad Request
POST {{Api}}/auth
Content-Type: application/json

{
  "email":"",
  "password":""
}

### POST "/auth" - Login "invalid field:email too short & other fields invalid" --> 400 Bad Request
POST {{Api}}/auth
Content-Type: application/json

{
  "email":"12345",
  "password":""
}

### POST "/auth" - Login "invalid field:email pattern & other fields invalid" --> 400 Bad Request
POST {{Api}}/auth
Content-Type: application/json

{
  "email":"mysite..1234@yopmail.com",
  "password":""
}

### POST "/auth" - Login "field:email OK & invalid field:password required" --> 400 Bad Request
POST {{Api}}/auth
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":""
}

### POST "/auth" - Login "invalid field:password too short & field:password required OK" --> 400 Bad Request
POST {{Api}}/auth
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"1234567"
}

### POST "/auth" - Login "invalid field:password pattern & other fields OK" --> 400 Bad Request
POST {{Api}}/auth
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"12345678"
}


### POST "/auth" - Login "wrong email" -> 400 Bad Request
POST {{Api}}/auth
Content-Type: application/json

{
  "email":"Lovelace@yopmail.com",
  "password":"Ab@12345"
}

### POST "/auth" - Login "wrong password" -> 400 Bad Request
POST {{Api}}/auth
Content-Type: application/json

{
  "email":"Kalush@yopmail.com",
  "password":"Aa@00000"
}

### POST "/auth" - Login (right credentials of NEW USER with Role 'User') -> 200 OK
POST {{Api}}/auth
Content-Type: application/json

{
  "email":"Kalush@yopmail.com",
  "password":"Aa@12345"
}

### POST "/auth" - Login (right credentials of NEW USER with Role 'User') -> 200 OK
POST {{Api}}/auth
Content-Type: application/json

{
  "email":"Kazka@yopmail.com",
  "password":"Ff@12345"
}

### POST "/auth" - Login (right credentials of SEED USER with Role 'User') -> 200 OK
POST {{Api}}/auth
Content-Type: application/json

{
  "email":"Dorofeeva@yopmail.com",
  "password":"Bb@12345"
}

### POST "/auth" - Login (right credentials of SEED ADMIN with Role 'Admin') -> 200 OK
POST {{Api}}/auth
Content-Type: application/json

{
  "email":"Tribunal@yopmail.com",
  "password":"Tribunal@uoc2026"
}

### POST "/auth" - Login (right credentials of SEED SUPERADMIN with Role 'Super') -> 200 OK
POST {{Api}}/auth
Content-Type: application/json

{
  "email":"Super@yopmail.com",
  "password":"Super@uoc2026"
}

